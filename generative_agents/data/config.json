{
    "agent": {
        "percept": {
            "mode": "box",
            "vision_r": 8,
            "att_bandwidth": 8
        },
        "schedule": {
            "max_try": 5,
            "diversity": 5
        },
        "think": {
            "llm": {
                "provider": "openai_json",
                "model": "deepseek-ai/DeepSeek-V4-Pro",
                "base_url": "https://api.siliconflow.cn/v1",
                "api_key": "${OPENAI_API_KEY}"
            },
            "llm_fast": {
                "provider": "openai_json",
                "model": "deepseek-ai/DeepSeek-V4-Flash",
                "base_url": "https://api.siliconflow.cn/v1",
                "api_key": "${OPENAI_API_KEY}"
            },
            "interval": 1000,
            "poignancy_max": 50,
            "reflect": true
        },
        "chat_iter": 4,
        "associate": {
            "embedding": {
                "provider": "openai",
                "model": "BAAI/bge-m3",
                "base_url": "https://api.siliconflow.cn/v1",
                "api_key": "${OPENAI_API_KEY}"
            },
            "retention": 8,
            "consolidate": {
                "enabled": true,
                "scope": ["event"],
                "sim_threshold": 0.6,
                "max_candidates": 4
            }
        }
    }
}
