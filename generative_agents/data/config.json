{
    "agent": {
        "percept": {
            "mode": "box",
            "vision_r": 8,
            "att_bandwidth": 8
        },
        "schedule": {
            "max_try": 5,
            "diversity": 5
        },
        "think": {
            "llm": {
                "provider": "openai",
                "model": "deepseek-v4-pro",
                "base_url": "https://yunwu.ai/v1",
                "api_key": "${OPENAI_API_KEY}"
            },
            "llm_fast": {
                "provider": "openai_json",
                "model": "deepseek-v4-flash",
                "base_url": "https://yunwu.ai/v1",
                "api_key": "${OPENAI_API_KEY}"
            },
            "interval": 1000,
            "poignancy_max": 50,
            "reflect": true
        },
        "chat_iter": 4,
        "associate": {
            "embedding": {
                "provider": "openai",
                "model": "text-embedding-3-large",
                "base_url": "https://yunwu.ai/v1",
                "api_key": "${OPENAI_API_KEY}"
            },
            "retention": 8
        }
    }
}
